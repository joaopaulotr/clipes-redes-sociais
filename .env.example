# Copie para .env e preencha.

# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelos: simples faz a triagem de todos os candidatos; complexo faz corte, título, gancho e spoiler.
LLM_SIMPLES=gpt-6-luna
LLM_COMPLEXO=gpt-6.1-terra
# LLM_COMPLEXO=gpt-6.1-sol   # melhor qualidade, ~2x o preço

# Nota mínima (0-10) na triagem para virar clipe
NOTA_MINIMA=6
# Máximo de clipes por vídeo enviado (padrão do formulário)
MAX_CLIPES=20
# Duração dos clipes (segundos)
CLIPE_MIN_S=15
CLIPE_MAX_S=60

# Whisper local: tiny, base, small (padrão), medium (melhor, mais lento)
WHISPER_MODELO=small

# Nome/arroba da sua conta, aparece no crédito do clipe (opcional)
MARCA=

# Se o YouTube pedir login: exporte cookies de uma conta secundária para um arquivo e aponte aqui
YTDLP_COOKIES=

# 127.0.0.1 = só neste PC. 0.0.0.0 = acessível pelo celular na mesma rede Wi-Fi (sem senha!)
HOST=127.0.0.1
PORT=8000
