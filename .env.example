# Copie para .env e preencha.

# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Modelos: simples faz a triagem de todos os candidatos; complexo faz corte, título, gancho e spoiler.
LLM_SIMPLES=gpt-6-luna
LLM_COMPLEXO=gpt-6.1-terra
# LLM_COMPLEXO=gpt-6.1-sol   # melhor qualidade, ~2x o preço

# Nota mínima (0-10) na triagem para virar clipe
NOTA_MINIMA=6
# Máximo de clipes por vídeo enviado (padrão do formulário)
MAX_CLIPES=20
# Duração dos clipes (segundos)
CLIPE_MIN_S=15
CLIPE_MAX_S=60

# Whisper local: tiny, base, small (padrão), medium (melhor, mais lento)
WHISPER_MODELO=small

# Nome/arroba da sua conta, aparece no crédito do clipe (opcional)
MARCA=

# Se o YouTube pedir login: exporte cookies de uma conta secundária para um arquivo e aponte aqui
YTDLP_COOKIES=

# 127.0.0.1 = só neste PC. 0.0.0.0 = acessível pelo celular na mesma rede Wi-Fi (sem senha!)
HOST=127.0.0.1
PORT=8000

# ---------- Monitor de lives (spec 002) ----------
# Bot do Telegram: crie com o @BotFather e cole o token. Depois mande "oi" ao bot e rode
#   uv run python -m clipes.avisos   para descobrir o TELEGRAM_CHAT_ID.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Endereço que o link do aviso abre no celular. Fora de casa: o endereço do Tailscale
# (ex.: https://meu-mac.tail1234.ts.net). Só em casa: http://<ip-do-mac>:8000
URL_BASE=http://localhost:8000
# Lives gravadas ao mesmo tempo (as de maior prioridade primeiro)
MAX_LIVES=3
# Clipes ao vivo por canal por hora (padrão de canal novo)
LIMITE_HORA=4
# Sensibilidade do pico: quantos desvios acima do normal do chat (menor = mais clipes)
LIMIAR_Z=3.0
# Mínimo de mensagens por segundo para contar como pico
MIN_MSGS_S=2.0
QUALIDADE_LIVE=720p60,720p,480p,best
